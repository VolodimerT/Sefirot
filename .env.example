# CORE 2.0 local mode requires no credentials.
# Optional: only for odds-events / fetch-odds. Do not commit a filled .env.
# Set this environment variable in PowerShell; .env is not loaded automatically.
SEFIROT_ODDS_API_KEY=
# Optional private Postgres session endpoint, used by `sync-supabase` only.
# Supply a sefirot_ingest password locally; never commit a filled value.
# The dashboard SSL Configuration page provides the project's CA certificate.
SEFIROT_SUPABASE_DB_DSN=
SEFIROT_SUPABASE_CA=
